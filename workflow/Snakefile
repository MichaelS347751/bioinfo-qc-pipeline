import pandas as pd
import os
import re

configfile: "projects/demo_project/config.yaml"

PROJECT = config["project"]

PROJECT_DIR = os.path.abspath(f"projects/{PROJECT}")
DATA_DIR = f"{PROJECT_DIR}/data"
RESULTS_DIR = f"{PROJECT_DIR}/results"
QC_DIR = f"{RESULTS_DIR}/qc"
LOG_DIR = f"{RESULTS_DIR}/logs"

FASTQC = config["tools"]["fastqc"]
MULTIQC = config["tools"]["multiqc"]

# Ensure result and log directories exist before rules run
for d in [RESULTS_DIR, QC_DIR, LOG_DIR,
          os.path.join(QC_DIR, "single"),
          os.path.join(QC_DIR, "paired"),
          os.path.join(LOG_DIR, "fastqc_single"),
          os.path.join(LOG_DIR, "fastqc_paired")]:
    os.makedirs(d, exist_ok=True)



import re

def parse_fastq_name(filename):
    """
    Extract:
    - sample base name
    - read (1 or 2 or None)
    - suffix (e.g. _trimmed)

    Returns: (sample, read, suffix)
    """

    pattern = r"""
        ^(.+?)                # sample name (non-greedy)
        (?:[_\.](R?)([12]))? # optional read indicator (_1, _R1)
        (_trimmed)?          # optional suffix
        \.fastq\.gz$
    """

    m = re.match(pattern, filename, re.VERBOSE)

    if not m:
        raise ValueError(f"Unrecognized FASTQ filename format: {filename}")

    sample = m.group(1)
    read = m.group(2)  # "1" or "2" or None
    suffix = m.group(3) or ""

    return sample, read, suffix

# -------------------------
# Function to detect fastq files from data folder
# -------------------------
def scan_fastq_files(data_dir):
    files = [f for f in os.listdir(data_dir) if f.endswith(".fastq.gz")]

    parsed = {}

    for f in files:
        sample, read, suffix = parse_fastq_name(f)

        key = (sample, suffix)

        if key not in parsed:
            parsed[key] = {"1": None, "2": None}

        if read == "1":
            parsed[key]["1"] = f
        elif read == "2":
            parsed[key]["2"] = f
        else:
            # single-end
            parsed[key]["1"] = f

    SAMPLE_MAP = {}

    for (sample, suffix), reads in parsed.items():
        r1 = reads["1"]
        r2 = reads["2"]

        # Mixed naming check
        if r1 and r2:
            # Ensure consistent suffix
            if suffix not in r1 or suffix not in r2:
                raise ValueError(f"Inconsistent suffix usage for sample {sample}")

        # Paired-end
        if r1 and r2:
            SAMPLE_MAP[sample + suffix] = {
                "file1": r1,
                "file2": r2
            }

        # Broken pair
        elif r1 and not r2 and re.search(r"(_1|_R1)", r1):
            raise FileNotFoundError(f"Missing pair for {r1}")

        # Single-end
        else:
            SAMPLE_MAP[sample + suffix] = {
                "file1": r1,
                "file2": None
            }

    return SAMPLE_MAP


# -------------------------
# Sample detection (CSV or AUTO)
# -------------------------

SAMPLE_MAP = {}

if os.path.exists(SAMPLES_CSV):
    print("Using samples.csv")

    SAMPLES = pd.read_csv(SAMPLES_CSV)

    # -------------------------
    # Validation
    # -------------------------
    required_cols = ["sample", "file1"]

    missing = [c for c in required_cols if c not in SAMPLES.columns]
    if missing:
        raise ValueError(f"Missing required columns in samples.csv: {missing}")

    if SAMPLES["sample"].duplicated().any():
        raise ValueError("Duplicate sample names detected in samples.csv")

    if SAMPLES["sample"].str.contains(r"\s").any():
        raise ValueError("Sample names must not contain spaces")

    # -------------------------
    # Build SAMPLE_MAP from CSV
    # -------------------------
    for _, row in SAMPLES.iterrows():
        sample = row["sample"]
        file1 = row["file1"]

        _, read, suffix = parse_fastq_name(file1)

        sample_key = sample + suffix

        if read == "2":
            raise ValueError(f"{file1} looks like read2 but listed as file1")

        f1_path = os.path.join(DATA_DIR, file1)
        if not os.path.exists(f1_path):
            raise FileNotFoundError(f"Missing file: {f1_path}")

        if read == "1":
            expected_r2 = file1.replace("_1", "_2").replace("_R1", "_R2")

            f2_path = os.path.join(DATA_DIR, expected_r2)
            if not os.path.exists(f2_path):
                raise FileNotFoundError(
                    f"Paired file not found for {sample}: expected {expected_r2}"
                )

            SAMPLE_MAP[sample_key] = {
                "file1": file1,
                "file2": expected_r2
            }

        else:
            SAMPLE_MAP[sample_key] = {
                "file1": file1,
                "file2": None
            }

else:
    print("No samples.csv found → scanning data directory")

    SAMPLE_MAP = scan_fastq_files(DATA_DIR)

# -------------------------
# Final validation
# -------------------------

if not SAMPLE_MAP:
    raise ValueError(f"No FASTQ files found in {DATA_DIR}")

if len(SAMPLE_MAP) != len(set(SAMPLE_MAP.keys())):
    raise ValueError("Duplicate sample names after parsing")


# -------------------------
# Derive sample groups
# -------------------------

PAIRED_SAMPLES = [s for s, v in SAMPLE_MAP.items() if v["file2"]]
SINGLE_SAMPLES = [s for s, v in SAMPLE_MAP.items() if not v["file2"]]

print("Detected samples:")
for s, v in SAMPLE_MAP.items():
    print(s, v)




wildcard_constraints:
    sample="[^/]+(?<!_[12])"

rule all:
    input:
        expand(f"{QC_DIR}/paired/{{sample}}_1_fastqc.html", sample=PAIRED_SAMPLES),
        expand(f"{QC_DIR}/paired/{{sample}}_2_fastqc.html", sample=PAIRED_SAMPLES),
        expand(f"{QC_DIR}/single/{{sample}}_fastqc.html", sample=SINGLE_SAMPLES),
        f"{QC_DIR}/multiqc_report.html"

rule fastqc_single:
    input:
        lambda wc: os.path.abspath(f"{DATA_DIR}/{SAMPLE_MAP[wc.sample]['file1']}")
    output:
        html=f"{QC_DIR}/single/{{sample}}_fastqc.html",
        zip=f"{QC_DIR}/single/{{sample}}_fastqc.zip"
    log:
        f"{LOG_DIR}/fastqc_single/{{sample}}.log"
    run:
        import shutil
        import os

        os.makedirs(os.path.dirname(output.html), exist_ok=True)
        os.makedirs(os.path.dirname(log[0]), exist_ok=True)

        shell(
            r'call "{FASTQC}" "{input}" > "{log}" 2>&1'
        )

        temp_html = os.path.join(DATA_DIR, f"{wildcards.sample}_fastqc.html")
        temp_zip = os.path.join(DATA_DIR, f"{wildcards.sample}_fastqc.zip")

        shutil.move(temp_html, output.html)
        shutil.move(temp_zip, output.zip)


rule fastqc_paired:
    input:
        r1=lambda wc: os.path.abspath(f"{DATA_DIR}/{SAMPLE_MAP[wc.sample]['file1']}"),
        r2=lambda wc: os.path.abspath(f"{DATA_DIR}/{SAMPLE_MAP[wc.sample]['file2']}")
    output:
        r1_html=f"{QC_DIR}/paired/{{sample}}_1_fastqc.html",
        r1_zip=f"{QC_DIR}/paired/{{sample}}_1_fastqc.zip",
        r2_html=f"{QC_DIR}/paired/{{sample}}_2_fastqc.html",
        r2_zip=f"{QC_DIR}/paired/{{sample}}_2_fastqc.zip"
    log:
        f"{LOG_DIR}/fastqc_paired/{{sample}}.log"
    run:
        import shutil
        import os

        os.makedirs(os.path.dirname(output.r1_html), exist_ok=True)
        os.makedirs(os.path.dirname(log[0]), exist_ok=True)

        shell(
            r'call "{FASTQC}" "{input.r1}" "{input.r2}" > "{log}" 2>&1'
        )

        temp_r1_html = os.path.join(DATA_DIR, f"{wildcards.sample}_1_fastqc.html")
        temp_r1_zip = os.path.join(DATA_DIR, f"{wildcards.sample}_1_fastqc.zip")
        temp_r2_html = os.path.join(DATA_DIR, f"{wildcards.sample}_2_fastqc.html")
        temp_r2_zip = os.path.join(DATA_DIR, f"{wildcards.sample}_2_fastqc.zip")

        shutil.move(temp_r1_html, output.r1_html)
        shutil.move(temp_r1_zip, output.r1_zip)
        shutil.move(temp_r2_html, output.r2_html)
        shutil.move(temp_r2_zip, output.r2_zip)


rule multiqc:
    input:
        expand(f"{QC_DIR}/paired/{{sample}}_1_fastqc.zip", sample=PAIRED_SAMPLES),
        expand(f"{QC_DIR}/paired/{{sample}}_2_fastqc.zip", sample=PAIRED_SAMPLES),
        expand(f"{QC_DIR}/single/{{sample}}_fastqc.zip", sample=SINGLE_SAMPLES)
    output:
        report=f"{QC_DIR}/multiqc_report.html"
    log:
        f"{LOG_DIR}/multiqc.log"
    run:
        import os

        os.makedirs(os.path.dirname(log[0]), exist_ok=True)

        shell(
            r'call "{MULTIQC}" "{QC_DIR}" --filename multiqc_report.html --outdir "{QC_DIR}" > "{log}" 2>&1'
        )